@chat_id = 57b7cc8d-3903-4017-80be-44b5089e64d9

### Retrieve metadata of all chat logs

GET {{base_url}}/v1/chat-history HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### Retrieve a chat log

GET {{base_url}}/v1/chat-history/{{chat_id}} HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### Post a new chat log

POST {{base_url}}/v1/chat-history HTTP/1.1
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{token}}

[
    { "role": "user", "content": "How much is the fish?", "timestamp": 1234 }
]

### Edit existing chat log

PUT {{base_url}}/v1/chat-history/{{chat_id}} HTTP/1.1
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{token}}

[
    { "role": "user", "content": "1+1=x?", "timestamp": 2345 },
    { "role": "assistant", "content": "x=2", "timestamp": 2346 }
]

### Delete a chat log

DELETE {{base_url}}/v1/chat-history/{{chat_id}} HTTP/1.1
Authorization: Bearer {{token}}

