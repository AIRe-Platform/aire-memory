    "name": "Pain management",
    "lang": "en", 
    "modified": "2024-02-22T00:00:00.000Z", 
    "keywords": [
        "quality of life",
        "pain management",
        "physical therapy"
    ], 
    "content": [ 
        {
            "id": "test_questions",
            "name": "Test questions",
            "questions": [ 
                {
                    "id": "test_question_1", 
                    "question": "How severe would you rank the pain you are experiencing?",
                    "prompt": "The user ranks their pain as {answer} on a scale from {min} to {max}.", 
                    "type": "range", 
                    "options": {
                        "min": 0, 
                        "max": 5 
                    }
                },
                {
                    "id": "test_question_2",
                    "question": "I have tried...",
                    "prompt": "The user has tried {answer}.",
                    "type": "checkbox",
                    "options": {
                        "values": [
                            "Pain medication",
                            "Stretching",
                            "Swearing and complaining",
                            "Contacting a professional"
                        ],
                        "multiselect": true 
                    }
                },
                {
                    "id": "test_question_3",
                    "question": "Please explain how and when the pain started.",
                    "prompt": "{answer}",
                    "type": "open", 
                    "options": {
                        "max_len": 120, 
                        "match": "/.+/g", 
                        "multiline": true
                    },
                    "required": true 
                },
                {
                    "id": "test_question_4",
                    "question": "How many hours you exercise in a week?",
                    "prompt": "The user says they exercise {answer} hours weekly.",
                    "type": "number", 
                    "options": {
                        "min": 0, 
                        "max": 100, 
                        "default": 6 
                    }
                }
            ]
        }
    ]
}